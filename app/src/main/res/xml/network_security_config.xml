<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Só HTTPS, com certificados do sistema. Nada de tráfego em texto puro. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
